{
  "name": "local-chat",
  "version": "1.0.0",
  "description": "Terminal chat for everyone on the same WiFi. One command, no accounts, no server.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "local-chat": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "prepublishOnly": "npm run build",
    "prebuild": "rm -rf dist",
    "postbuild": "chmod +x dist/index.js"
  },
  "keywords": [
    "chat",
    "cli",
    "terminal",
    "tui",
    "lan",
    "wifi",
    "local-network",
    "p2p",
    "websocket",
    "encrypted",
    "ink",
    "npx",
    "boss-mode"
  ],
  "author": "DongGunYoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DongGunYoon/local-chat.git"
  },
  "bugs": {
    "url": "https://github.com/DongGunYoon/local-chat/issues"
  },
  "homepage": "https://github.com/DongGunYoon/local-chat#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1",
    "string-width": "^7.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
